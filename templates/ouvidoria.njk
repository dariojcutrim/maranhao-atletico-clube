<!DOCTYPE html>
<html lang="pt-BR">
<head>
{% set page_title = ouvidoria.title + " — Maranhão Atlético Clube" %}
{% set page_desc = "Canal de ouvidoria do Maranhão Atlético Clube — reclamações, sugestões e elogios." %}
{% include "_head.njk" %}
</head>
<body>

{% set activeNav = 'ouvidoria' %}
{% include "_header.njk" %}

  <section class="page-head">
    <div class="container"><h1 class="section-title">{{ ouvidoria.title }}</h1></div>
  </section>
  <section class="section-sm">
    <div class="container">
      <div class="form-grid">
        <div class="contact-info">
          {%- for p in ouvidoria.paragraphs %}
          <p style="margin-bottom:16px;">{{ p | md | safe }}</p>
          {%- endfor %}
          <p>O endereço eletrônico é: <a href="mailto:{{ ouvidoria.email }}">{{ ouvidoria.email }}</a></p>
        </div>
        <form class="club-form" name="ouvidoria" method="POST" action="/api/enviar" data-email-alternativo="{{ ouvidoria.email }}">
          <input type="hidden" name="form-name" value="ouvidoria">
          <p hidden><label>Não preencha isto: <input name="bot-field"></label></p>
          <div class="form-feedback"></div>
          <div class="field"><label>Nome: <span class="req">*</span></label><input type="text" name="nome" placeholder="Digite seu nome completo" required></div>
          <div class="field"><label>Celular/WhatsApp: <span class="req">*</span></label><input type="tel" name="celular" placeholder="Digite seu número de celular/WhatsApp" required></div>
          <div class="field"><label>Telefone Residencial:</label><input type="tel" name="telefone_residencial" placeholder="Digite seu telefone residencial"></div>
          <div class="field"><label>E-mail: <span class="req">*</span></label><input type="email" name="email" placeholder="Digite seu e-mail" required></div>
          <div class="field"><label>Matrícula:</label><input type="text" name="matricula" placeholder="Se for associado"></div>
          <div class="field"><label>Mensagem <span class="req">*</span></label><textarea name="mensagem" placeholder="Escreva sua dúvida, sugestão ou solicitação" required></textarea></div>
          <p class="form-note">Ao enviar, você concorda com nossa <a href="privacidade">Política de Privacidade</a>.</p>
          <div><button type="submit" class="btn btn-primary">Enviar</button></div>
        </form>
      </div>
    </div>
  </section>

{% include "_footer.njk" %}

  <script src="assets/js/main.js"></script>
</body>
</html>
