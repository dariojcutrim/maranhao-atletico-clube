<!DOCTYPE html>
<html lang="pt-BR">
<head>
{% set page_title = termos.title + " — Maranhão Atlético Clube" %}
{% set page_desc = "Termos de cotações do Maranhão Atlético Clube." %}
{% include "_head.njk" %}
</head>
<body>

{% set activeNav = 'termos' %}
{% include "_header.njk" %}

  <section class="page-head">
    <div class="container"><h1 class="section-title">{{ termos.title }}</h1></div>
  </section>
  <section class="section-sm">
    <div class="container">
      <ul class="terms-list">
        <div class="terms-divider"></div>
        {%- for item in termos.items %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </div>
  </section>

{% include "_footer.njk" %}

  <script src="assets/js/main.js"></script>
</body>
</html>
