<!DOCTYPE html>
<html lang="pt-BR">
<head>
{% set page_title = "Galeria — Maranhão Atlético Clube" %}
{% set page_desc = "Os melhores momentos do Maranhão Atlético Clube em fotos, dentro e fora de campo." %}
{% include "_head.njk" %}
</head>
<body class="hero-page">

{% set activeNav = 'galeria' %}
{% include "_header.njk" %}

  <div class="hero-backer">
  <section class="hero" style="min-height:420px;">
    <img class="hero-bg" data-rotate='{{ galeria.hero.slides | pluck("src") | dump | safe }}' src="{{ galeria.hero.slides[0].src }}" alt="Momentos do MAC">
    <div class="hero-content"><div class="container">
      <h1>{{ galeria.hero.title | md | safe }}</h1>
      <p class="subtitle">{{ galeria.hero.subtitle | md | safe }}</p>
    </div></div>
  </section>
  </div>
  <section class="section">
    <div class="container">
      <h2 class="section-title">{{ galeria.section_title }}</h2>

      {#- Anos presentes nas fotos, do mais recente para o mais antigo -#}
      {%- set anos = [] %}
      {%- for img in galeria.images %}
        {%- if img.year and img.year not in anos %}{% set anos = (anos.push(img.year), anos) %}{% endif %}
      {%- endfor %}
      {%- set anos = anos | sort(true) %}

      {%- if anos.length %}
      <div class="gallery-filtros" role="group" aria-label="Filtrar fotos por ano">
        <button type="button" class="gallery-filtro is-active" data-ano="">{{ galeria.filter_all if galeria.filter_all else 'Todas' }}</button>
        {%- for ano in anos %}
        <button type="button" class="gallery-filtro" data-ano="{{ ano }}">{{ ano }}</button>
        {%- endfor %}
      </div>
      {%- endif %}

      <div class="gallery-grid">
        {%- for img in galeria.images %}
        <img src="{{ img.src }}" alt="{{ img.alt if img.alt else 'Foto do Maranhão Atlético Clube' }}" loading="lazy"{% if img.year %} data-ano="{{ img.year }}"{% endif %}>
        {%- endfor %}
      </div>
      <p class="gallery-vazio" hidden>Nenhuma foto neste ano ainda.</p>
    </div>
  </section>
  <div class="lightbox"><span class="close">&times;</span><img src="" alt="Foto ampliada"></div>

{% include "_footer.njk" %}

  <script src="assets/js/main.js"></script>
</body>
</html>
