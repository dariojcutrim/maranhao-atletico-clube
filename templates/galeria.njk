<!DOCTYPE html>
<html lang="pt-BR">
<head>
{% set page_title = "Galeria — Maranhão Atlético Clube" %}
{% set page_desc = "Os melhores momentos do Maranhão Atlético Clube em fotos, dentro e fora de campo." %}
{% include "_head.njk" %}
</head>
<body>

{% set activeNav = 'galeria' %}
{% include "_header.njk" %}

  <section class="hero" style="min-height:420px;">
    <img class="hero-bg" data-rotate='{{ galeria.hero.slides | dump | safe }}' src="{{ galeria.hero.slides[0] }}" alt="Momentos do MAC">
    <div class="hero-content"><div class="container">
      <h1>{{ galeria.hero.title }} <span class="accent">{{ galeria.hero.title_accent }}</span></h1>
      <p class="subtitle">{{ galeria.hero.subtitle }}</p>
    </div></div>
  </section>
  <section class="section">
    <div class="container">
      <h2 class="section-title">{{ galeria.section_title }}</h2>
      <div class="gallery-grid">
        {%- for img in galeria.images %}
        <img src="{{ img }}" alt="Foto do MAC" loading="lazy">
        {%- endfor %}
      </div>
    </div>
  </section>
  <div class="lightbox"><span class="close">&times;</span><img src="" alt="Foto ampliada"></div>

{% include "_footer.njk" %}

  <script src="assets/js/main.js"></script>
</body>
</html>
