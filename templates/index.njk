<!DOCTYPE html>
<html lang="pt-BR">
<head>
{% set page_title = home.meta.title %}
{% set page_desc = home.meta.description %}

{#- Identidade do clube para os buscadores.
    O "sameAs" é a parte que mais importa: ele diz ao Google que este site e os
    perfis oficiais do MAC são a mesma entidade. Como o Google cruza essa
    informação nos dois sentidos, o efeito só se completa quando as redes do
    clube também apontarem para cá — está anotado como pendência para o Erick. -#}
{% set page_jsonld = {
  "@context": "https://schema.org",
  "@type": "SportsTeam",
  "name": "Maranhão Atlético Clube",
  "alternateName": ["MAC", "Maranhão A.C.", "Machão da Ilha"],
  "sport": "Futebol",
  "url": site_url,
  "logo": site_url + "/assets/img/escudo-mac.png",
  "image": site_url + "/assets/img/og-image.jpg",
  "description": page_desc,
  "foundingDate": "1932-09-24",
  "foundingLocation": { "@type": "Place", "name": "São Luís, Maranhão, Brasil" },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": contato.address,
    "addressLocality": "São Luís",
    "addressRegion": "MA",
    "addressCountry": "BR"
  },
  "email": contato.email,
  "sameAs": [site.social.instagram, site.social.youtube]
} %}
{% include "_head.njk" %}
</head>
<body class="home">

{% include "_header.njk" %}

  <!-- ====================== HERO ====================== -->
  <div class="hero-backer">
  <section class="hero hero-home">
    <div class="hero-slides">
      {%- for s in home.hero.slides %}
      <img class="hero-slide{% if loop.first %} is-active{% endif %}" src="{{ s.src }}" alt="{% if loop.first %}Elenco do Maranhão Atlético Clube{% endif %}"{% if not loop.first %} loading="lazy"{% endif %}>
      {%- endfor %}
    </div>
    <div class="hero-content">
      <div class="container">
        <h1>{{ home.hero.title_line1 | md | safe }}<br>{{ home.hero.title_line2 | md | safe }}</h1>
        <p class="subtitle">{{ home.hero.subtitle | md | safe }}</p>
      </div>
    </div>
  </section>
  </div>

  <!-- ====================== NÚMEROS / CONQUISTAS ====================== -->
  <section class="stats-band">
    <div class="container">
      {%- for stat in home.stats %}
      <div class="stat reveal" style="--i:{{ loop.index0 }}"><div class="num">{% if stat.count %}<span class="count" data-count="{{ stat.count }}"{% if stat.prefix %} data-prefix="{{ stat.prefix }}"{% endif %}>{{ stat.prefix }}{{ stat.number }}</span>{% else %}{{ stat.prefix }}{{ stat.number }}{% endif %}{% if stat.suffix %}<small>{{ stat.suffix }}</small>{% endif %}</div><div class="label">{{ stat.label }}</div></div>
      {%- endfor %}
    </div>
  </section>

  <!-- ====================== ÚLTIMAS NOTÍCIAS ====================== -->
  {%- if noticias.length %}
  <section class="section">
    <div class="container">
      <h2 class="section-title reveal">Últimas notícias</h2>
      <div class="materia-grid">
        {%- for n in noticias %}
          {%- if loop.index <= 3 %}
          {% include "_materia-card.njk" %}
          {%- endif %}
        {%- endfor %}
      </div>
      <div class="reveal" style="text-align:center; margin-top:36px;">
        <a href="noticias" class="btn btn-primary">Ver todas as notícias</a>
      </div>
    </div>
  </section>
  {%- endif %}

  <!-- ====================== SOBRE ====================== -->
  <section class="section">
    <div class="container">
      <h2 class="section-title reveal">{{ home.sobre.title }}</h2>
      <div class="about-grid">
        <div class="about-text reveal">
          {%- for p in home.sobre.paragraphs %}
          <p>{{ p | md | safe }}</p>
          {%- endfor %}
        </div>
        <div class="about-collage">
          {%- for img in home.sobre.images %}
          <img class="reveal" style="--i:{{ loop.index0 }}" src="{{ img.src }}" alt="{{ img.alt }}">
          {%- endfor %}
        </div>
      </div>
    </div>
  </section>

  <!-- ====================== PATROCINADORES ====================== -->
  <section class="section sponsors">
    <div class="container">
      <h2 class="section-title reveal">{{ home.sponsors.title }}</h2>
      <div class="sponsor-grid">
        {%- for s in sponsors.items %}
        <div class="sponsor-card reveal" style="--i:{{ loop.index0 }}">
          <div class="sponsor-logo"><img src="{{ s.logo }}" alt="{{ s.name }}"></div>
        </div>
        {%- endfor %}
      </div>

      <div class="reveal" style="text-align:center; margin-top:48px;">
        <a href="contato" class="btn btn-primary">{{ home.sponsors.cta }}</a>
      </div>

      <div class="support-row reveal">
        <h4>{{ home.apoio.title }}</h4>
        <div class="support-logos">
          {%- for item in home.apoio.items %}
          <span>{{ item }}</span>{% if not loop.last %}<span>•</span>{% endif %}
          {%- endfor %}
        </div>
      </div>
    </div>
  </section>

{% include "_footer.njk" %}

  <script src="assets/js/main.js"></script>
</body>
</html>
