<!DOCTYPE html>
<html lang="pt-BR">
<head>
{% set page_title = diretoria.title + " — Maranhão Atlético Clube" %}
{% set page_desc = "Conheça a diretoria executiva do Maranhão Atlético Clube." %}
{% include "_head.njk" %}
</head>
<body>

{% set activeNav = 'diretoria' %}
{% include "_header.njk" %}

  <section class="page-head">
    <div class="container"><h1 class="section-title">{{ diretoria.title }}</h1></div>
  </section>
  <section class="section-sm">
    <div class="container">
      <p class="board-intro">{{ diretoria.intro | md | safe }}</p>
      <div class="board-list">
        {%- for m in diretoria.members %}
        <div class="board-item"><h4>{{ m.role }}</h4><p>{{ m.name }}</p></div>
        {%- endfor %}
        <div class="board-item council"><h4>{{ diretoria.council.title }}</h4><p>{% for member in diretoria.council.members %}{{ member }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p></div>
      </div>
    </div>
  </section>

{% include "_footer.njk" %}

  <script src="assets/js/main.js"></script>
</body>
</html>
