<!DOCTYPE html>
<html lang="pt-BR">
<head>
{% set page_title = diretoria.title + " — Maranhão Atlético Clube" %}
{% set page_desc = "Conheça a diretoria executiva do Maranhão Atlético Clube." %}
{% include "_head.njk" %}
</head>
<body>

{% set activeNav = 'diretoria' %}
{% include "_header.njk" %}

  <section class="page-head">
    <div class="container"><h1 class="section-title">{{ diretoria.title }}</h1></div>
  </section>
  <section class="section-sm">
    <div class="container">
      <p class="board-intro">{{ diretoria.intro | md | safe }}</p>
      <div class="board-grid">
        {%- for m in diretoria.members %}
        <article class="board-card">
          {%- if m.photo %}
          <div class="board-photo"><img src="{{ m.photo }}" alt="{{ m.name }} — {{ m.role }}" loading="lazy"></div>
          {%- endif %}
          <div class="board-info">
            <span class="board-role">{{ m.role }}</span>
            <h3 class="board-name">{{ m.name }}</h3>
            {%- if m.nationality %}<span class="board-nat">{{ m.nationality }}</span>{% endif %}
          </div>
        </article>
        {%- endfor %}
      </div>
      {%- if diretoria.council and diretoria.council.members %}
      <div class="board-list">
        <div class="board-item council"><h4>{{ diretoria.council.title }}</h4><p>{% for member in diretoria.council.members %}{{ member }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p></div>
      </div>
      {%- endif %}
    </div>
  </section>

{% include "_footer.njk" %}

  <script src="assets/js/main.js"></script>
</body>
</html>
