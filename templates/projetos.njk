<!DOCTYPE html>
<html lang="pt-BR">
<head>
{% set page_title = projetos.title + " — Maranhão Atlético Clube" %}
{% set page_desc = "Projetos do Maranhão Atlético Clube: formação de atletas, temporada profissional e ações sociais." %}
{% include "_head.njk" %}
</head>
<body>

{% set activeNav = 'projetos' %}
{% include "_header.njk" %}

  <section class="page-head">
    <div class="container"><h1 class="section-title">{{ projetos.title }}</h1></div>
  </section>
  <section class="section-sm">
    <div class="container">
      {%- for proj in projetos.items %}
      <div class="project-block{% if proj.reverse %} reverse{% endif %}">
        <div class="project-img"><img src="{{ proj.image }}" alt="{{ proj.image_alt }}"{% if proj.image_position %} style="object-position: {{ proj.image_position }};"{% endif %}></div>
        <div class="project-info">
          <h3>{{ proj.title }}</h3>
          <p class="project-meta">{% for m in proj.meta %}<strong>{{ m.label }}:</strong> {{ m.value }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
          {%- for p in proj.paragraphs %}
          <p>{{ p | md | safe }}</p>
          {%- endfor %}
        </div>
      </div>
      {%- endfor %}
    </div>
  </section>

{% include "_footer.njk" %}

  <script src="assets/js/main.js"></script>
</body>
</html>
