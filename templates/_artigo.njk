{#- Página de UMA matéria. Não é gerada sozinha (por isso o "_"):
    o build.js renderiza este arquivo uma vez para cada matéria. -#}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
{% set page_title = noticia.title + " — Maranhão Atlético Clube" %}
{% set page_desc = noticia.summary if noticia.summary else (noticia.corpo | resumo(160)) %}
{% set page_type = "article" %}
{% set page_image = noticia.image_url %}
{% set page_published = noticia.date %}
{% set page_section = noticia.category %}

{#- Assinatura: só existe se o painel preencheu o campo Autor. A posição vem
    do painel também; sem escolha, fica no topo. -#}
{% set autorPos = noticia.author_position if noticia.author_position else "topo" %}
{% set autorTopo = noticia.author and autorPos != "fim" %}
{% set autorFim = noticia.author and autorPos != "topo" %}

{#- Com autor nomeado, o Google prefere Person a Organization: é o sinal de
    que existe gente real por trás do texto. Sem autor, o clube assina. -#}
{% set autorLd = { "@type": "Person", "name": noticia.author } if noticia.author
   else { "@type": "Organization", "name": "Maranhão Atlético Clube", "url": site_url } %}

{#- Dados estruturados de notícia. É o que permite a matéria aparecer como
    notícia no Google (e não como página comum), com data e foto. O bloco
    "publisher" é o que identifica o clube como a fonte — importante porque
    existe outro site na internet se apresentando como oficial. -#}
{% set page_jsonld = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": noticia.title,
  "description": page_desc,
  "datePublished": noticia.date,
  "dateModified": noticia.date,
  "image": noticia.image_url,
  "articleSection": noticia.category,
  "inLanguage": "pt-BR",
  "mainEntityOfPage": { "@type": "WebPage", "@id": page.url },
  "author": autorLd,
  "publisher": {
    "@type": "Organization",
    "name": "Maranhão Atlético Clube",
    "url": site_url,
    "logo": { "@type": "ImageObject", "url": site_url + "/assets/img/escudo-mac.png" }
  },
  "about": { "@type": "SportsTeam", "name": "Maranhão Atlético Clube", "url": site_url }
} %}
{% include "_head.njk" %}
</head>
<body>

{% set activeNav = 'noticias' %}
{% include "_header.njk" %}

  <section class="page-head">
    <div class="container">
      <p class="artigo-volta"><a href="noticias">← Voltar para as notícias</a></p>
      <div class="artigo-meta">
        {%- if noticia.category %}<span class="materia-tag">{{ noticia.category }}</span>{% endif %}
        {%- if noticia.date %}<span class="artigo-data">{{ noticia.date | data }}</span>{% endif %}
      </div>
      <h1 class="section-title">{{ noticia.title }}</h1>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
     <div class="doc artigo">

      {%- if noticia.image %}
      <img class="artigo-foto" src="{{ noticia.image }}" alt="{{ noticia.image_alt if noticia.image_alt else noticia.title }}">
      {%- endif %}

      {%- if noticia.summary %}
      <p class="artigo-resumo">{{ noticia.summary }}</p>
      {%- endif %}

      {%- if autorTopo %}
      <p class="artigo-autor artigo-autor--topo">Por <span>{{ noticia.author }}</span></p>
      {%- endif %}

      <div class="artigo-corpo">{{ noticia.corpo | markdown | safe }}</div>

      {%- if autorFim %}
      <p class="artigo-autor artigo-autor--fim">Por <span>{{ noticia.author }}</span></p>
      {%- endif %}

      {#- Outras matérias, exceto esta -#}
      {%- set outras = [] %}
      {%- for n in noticias %}
        {%- if n.slug != noticia.slug and outras.length < 3 %}{% set outras = (outras.push(n), outras) %}{% endif %}
      {%- endfor %}

      {%- if outras.length %}
      <section class="doc-section" style="margin-top:48px;">
        <h2>Leia também</h2>
        <div class="materia-grid">
          {%- for n in outras %}
          {% include "_materia-card.njk" %}
          {%- endfor %}
        </div>
      </section>
      {%- endif %}

     </div>
    </div>
  </section>

{% include "_footer.njk" %}

  <script src="assets/js/main.js"></script>
</body>
</html>
