<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ faq.title }} — Maranhão Atlético Clube</title>
  <link rel="icon" type="image/png" href="assets/img/escudo-mac.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Saira+Condensed:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="assets/css/style.css">
</head>
<body>

{% set activeNav = 'faq' %}
{% include "_header.njk" %}

  <section class="page-head">
    <div class="container"><h1 class="section-title">{{ faq.title }}</h1></div>
  </section>
  <section class="section-sm">
    <div class="container">
      <div class="faq-list">
        {%- for item in faq.items %}
        <div class="faq-item"><button class="faq-q">{{ item.question }} <span class="chev">&#10095;</span></button><div class="faq-a"><p>{{ item.answer }}</p></div></div>
        {%- endfor %}
      </div>
    </div>
  </section>

{% include "_footer.njk" %}

  <script src="assets/js/main.js"></script>
</body>
</html>
