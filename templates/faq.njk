<!DOCTYPE html>
<html lang="pt-BR">
<head>
{% set page_title = faq.title + " — Maranhão Atlético Clube" %}
{% set page_desc = "Perguntas frequentes sobre o Maranhão Atlético Clube: sócio, categorias de base, ingressos e mais." %}
{% include "_head.njk" %}
</head>
<body>

{% set activeNav = 'faq' %}
{% include "_header.njk" %}

  <section class="page-head">
    <div class="container"><h1 class="section-title">{{ faq.title }}</h1></div>
  </section>
  <section class="section-sm">
    <div class="container">
      <div class="faq-list">
        {%- for item in faq.items %}
        <div class="faq-item"><button class="faq-q">{{ item.question }} <span class="chev">&#10095;</span></button><div class="faq-a"><p>{{ item.answer | md | safe }}</p></div></div>
        {%- endfor %}
      </div>
    </div>
  </section>

{% include "_footer.njk" %}

  <script src="assets/js/main.js"></script>
</body>
</html>
